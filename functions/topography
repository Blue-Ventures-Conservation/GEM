exports.topo_mask = function(topo, topo_path, mangroves, mang_topo, elevation, elevationPercentile, slopeEnabled, slope, slopePercentile) {
  if (topo === true) {
    return fabdemTopoMask(mangroves, mang_topo, elevation, elevationPercentile, slopeEnabled, slope, slopePercentile);
  } else {
    return handleTopo(ee.Image(topo_path).rename('elev'), mangroves, mang_topo, elevation, elevationPercentile, slopeEnabled, slope, slopePercentile, "User Provided Elevation Model");
  }
};

function handleTopo(img, mangroves, mang_topo, elevation, elevationPercentile, slopeEnabled, slope, slopePercentile, label) {
  var model = ee.Image(img);
  
  if (slopeEnabled) {
    model = model.addBands(ee.Terrain.slope(model.select('elev')).double().rename('slope'));
  }
  
  var el_img = ee.Image.constant(elevation);
  var slp_img = ee.Image.constant(slope);
  
  if (mang_topo === true) {
    //extract slope and elevation max from known mangrove extent
    var mang_elv = model.select('elev').updateMask(mangroves)
      .reduceRegion({
        reducer: ee.Reducer.percentile({percentiles: [elevationPercentile]}),
        geometry: mangroves.geometry(),
        scale: 30,
        maxPixels: 1e12,
        bestEffort: true
    });

    var mang_slope = model.select('slope').updateMask(mangroves)
     .reduceRegion({
        reducer: ee.Reducer.percentile({percentiles: [slopePercentile]}),
        geometry: mangroves.geometry(),
        scale: 30,
        maxPixels: 1e12,
        bestEffort: true
    });
    var el_val = mang_elv.get('elev');
    var slp_val = mang_slope.get('slope');
    el_img = ee.Algorithms.If(el_val, ee.Image.constant(el_val), ee.Image.constant(elevation));
    slp_img = ee.Algorithms.If(slp_val, ee.Image.constant(slp_val), ee.Image.constant(slope));
    
    var fetchStr = " " + elevationPercentile + "th percentile elevation\n";
    var toFetch = ee.List([el_val]);
    if (slopeEnabled) {
      fetchStr += "and " + slopePercentile + "th percentile slope\n";
      toFetch = toFetch.add(slp_val);
    }
    
    print("Fetching" + fetchStr + "for known mangrove extent...");
    toFetch.evaluate(function(vals, failure) {
      if (vals !== undefined) {
        var known_elev = vals[0];
        if (known_elev !== null) {
          print(label + " " + elevationPercentile + "th percentile known mangrove elevation: " + known_elev);
          if (slopeEnabled) {
            print(label + " " + slopePercentile + "th percentile known mangrove slope: " + vals[1]);
          }
        } else {
          var fallbackMsg = "Could not calculate" + fetchStr + "Falling back to user-defined elevationThreshold: " + elevation;
          if (slopeEnabled) {
            fallbackMsg += "\nFalling back to user-defined slopeThreshold: " + slope;
          }
          print(fallbackMsg);
        }
      } else {
        print("Could not retrieve " + fetchStr + failure);
      }
    });
  }
  
  var topo_mask = model.select('elev').lte(el_img);
  if (slopeEnabled) {
    topo_mask = topo_mask.and(model.select('slope').lte(slp_img));
  }
  
  return topo_mask.double();
}



